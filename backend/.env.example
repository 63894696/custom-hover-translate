# =============================================================================
# Custom Hover Translate — backend .env (RELEASE VERSION)
#
# Setup:
#   cp .env.example .env       (Linux/Mac)
#   copy .env.example .env     (Windows)
#   Then fill in your own LLM API keys (or leave empty for Google Translate gtx).
#
# IMPORTANT:
#   - DO NOT commit .env to git (it's in .gitignore).
#   - All keys are placeholders. The real keys live only in YOUR local .env.
#   - This release was published with all real keys revoked and replaced.
# =============================================================================

# ---- Server ----------------------------------------------------------------
# Listen port. The extension defaults to 12308. If you change this, also
# update "Endpoint URL" in the extension's options page.
PORT=12308

# ---- LLM Provider ----------------------------------------------------------
# Built-in providers (no baseURL needed):
#   google_gtx : Google Translate public endpoint (NO key required) — default
#   bailian    : Alibaba Bailian / DashScope (OpenAI-compatible)
#   doubao     : Volcano Ark (Doubao Seed 1.6 Flash)
#   openrouter : OpenRouter (free + paid models)
#   ollama     : Local Ollama (no key, requires `ollama serve` running)
#   qwen-mt    : Alibaba Qwen MT (machine translation specialized)
#   minimax    : legacy (kept for compat)
#   deepseek   : legacy (kept for compat)
#   openai     : OpenAI gpt-4o-mini (paid)
#   custom     : use LLM_BASE_URL + LLM_MODEL below
LLM_PROVIDER=google_gtx

# ---- Provider credentials (only fill in the ones you actually use) ---------

# Alibaba Bailian / DashScope / Qwen-MT (uses LLM_API_KEY)
# Get one: https://dashscope.console.aliyun.com/apiKey
LLM_API_KEY=your-bailian-key-here

# Volcano Ark (uses DOUBAO_API_KEY, NOT LLM_API_KEY)
# Get one: https://www.volcengine.com/product/doubao
DOUBAO_API_KEY=your-doubao-key-here

# OpenRouter (uses OPENROUTER_API_KEY, NOT LLM_API_KEY)
# Get one: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-key-here

# Custom OpenAI-compatible endpoint (only when LLM_PROVIDER=custom)
LLM_BASE_URL=
LLM_MODEL=

# ---- Fallback chain --------------------------------------------------------
# When the active provider fails (429/403/5xx/network), automatically try the
# next one in this list. Comma-separated. Order matters — first entry is the
# "primary" choice when LLM_PROVIDER is not in the list.
PROVIDER_FALLBACK_CHAIN=google_gtx,bailian,doubao,openrouter
PROVIDER_FALLBACK_ENABLED=true

# ---- Inference parameters --------------------------------------------------
LLM_MAX_TOKENS=800
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_MS=30000

# ---- Mock fallback ---------------------------------------------------------
# When LLM_API_KEY is missing or is a placeholder string (starts with "your-"
# or contains "placeholder"), the backend will return mock translations
# ("[mock @ provider/model] <original text>") without making any network
# request. This lets you run the extension end-to-end before buying API keys.
ENABLE_MOCK=true
