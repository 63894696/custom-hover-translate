{
  "manifest_version": 3,
  "name": "Custom Hover Translate",
  "version": "0.1.0",
  "description": "悬停段落自动追加中文译文。后端走自部署 OpenAI 兼容服务(bailian/doubao/openrouter/deepseek/qwen-mt/ollama 等),支持多 provider 热切 + fallback 链。",
  "minimum_chrome_version": "116",
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    },
    "default_title": "Custom Hover Translate"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["file:///*"],
      "js": ["src/content.js"],
      "css": ["src/inject.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "activeTab", "scripting", "webNavigation", "contextMenus"],
  "host_permissions": [
    "http://127.0.0.1:12308/*",
    "http://localhost:12308/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
